generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid())
  email String @unique
  password String
  name String
  failedLogins Int @default(0)
  lockedUntil DateTime?
  workers Worker[]
  jobs Job[]
}
model Worker {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id])
  name String
  tokenHash String
  disabled Boolean @default(false)
  capabilities Json @default("{}")
  lastSeen DateTime?
  createdAt DateTime @default(now())
  jobs Job[]
  @@index([ownerId])
}
model Job {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id])
  workerId String
  worker Worker @relation(fields:[workerId],references:[id])
  status String @default("queued")
  config Json
  progress Json @default("{}")
  sequence Int @default(0)
  leaseHash String?
  leaseExpiresAt DateTime?
  cancelRequested Boolean @default(false)
  kind String @default("training")
  audio Json?
  audioExpiresAt DateTime?
  audioDeletedAt DateTime?
  audioCleanupCheckedAt DateTime?
  segments BirdSegment[]
  artifactPath String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  @@index([workerId,status,createdAt])
  @@index([ownerId,createdAt])
  @@index([kind,audioExpiresAt])
}

model BirdSegment {
  jobId String
  job Job @relation(fields:[jobId],references:[id],onDelete:Cascade)
  ordinal Int
  startSeconds Float
  endSeconds Float
  species String
  confidence Float
  windowIndex Int?
  status String @default("detected")
  commonName String?
  globalConfidence Float?
  customConfidence Float?
  evidence String?
  @@id([jobId,ordinal])
}
