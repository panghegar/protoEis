DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_ORIGINS=http://127.0.0.1:5173
PORT=3001
# Optional model ZIP upload: private bucket only. Never put these in VITE_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=training-artifacts
# Only for npm run seed; do not configure a default shared password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
